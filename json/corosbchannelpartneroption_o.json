      "screenshot":"screenshots/last.png"
    },

    {
      "action":"click",
      "selector":"//span[@class='qtext']//a[text()='View Assets']"
    },

     {
      "action": "wait",
      "timeout": 5000
    },

    {
      "action":"back"
    },

    {
      "action":"reload"
    },

    {
      "action": "wait",
      "timeout": 5000
