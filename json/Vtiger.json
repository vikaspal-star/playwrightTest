{
  "name": "coro-sb channelpartner/option_o",
  "steps": [
    {
      "action": "navigate",
      "url": "http://localhost:8888/"
    },
    {
      "action": "wait-for-selector",
      "selector": "//input[@name='user_name']"
    },
    {
      "action": "fill",
      "selector": "//input[@name='user_name']",
      "value": "admin"
    },
    {
      "action": "fill",
      "selector": "//input[@name='user_password']",
      "value": "admin"
    },
    {
      "action": "click",
      "selector": "//input[@id='submitButton']"
    },
    {
      "action": "wait",
      "timeout": 2000
    },
    {
      "action": "browser-url-changed",
      "url": "http://localhost:8888/index.php?action=index&module=Home"
    },
    
    {
      "action": "screenshot",
      "screenshot": "screenshots/vTiger/Dashboard.png"
    },

     {
      "action": "click",
      "selector": "//a[@href='index.php?module=Leads&action=index']"
    },

    {
      "action": "click",
      "selector": "//img[@title='Create Lead...']"
    },  

    {
        "action":"element-text",
        "selector":"//b[normalize-space()='Lead Information']",
        "text":"Lead Information"
    },

    {
        "action":"select",
        "selector":"//select[@name='salutationtype']",
        "value":"Mr."
    },

    {
        "action":"fill",
        "selector":"//input[@name='firstname']",
        "value":"john"

    },

    {
        "action":"fill",
        "selector":"//input[@name='lastname']",
        "value":"die"

    },

    {
        "action":"fill",
        "selector":"//input[@name='company']",
        "value":"john_die"
    },

    {
        "action":"select",
        "selector":"//select[@name='leadsource']",
        "value":"Employee"

    },

    {
        "action":"select",
        "selector":"//select[@name='industry']",
        "value":"Banking"

    },

    
    {
        "action":"check",
        "selector":"//input[@name='assigntype' and @value='T']"
    },

    {
        "action":"click",
        "selector": "//input[@class='crmbutton small cancel' and @value='Cancel  ']"
    },

    {
        "action":"click",
        "selector":"(//table[@class='small']//a[@alt='Next'])[1]"
    },

    {
        "action":"hover",
        "selector":"//td[@class='small']//table//tr//td[@class='small']//a"
    },

    {
        "action":"click",
        "selector":"//a[normalize-space()='Help']"
    },

     {
      "action": "wait",
      "timeout": 10000
    },

    {
      "action": "switch-tab",
      "pageName": "main"
    },

    {
      "action":"switch-page-by-url",
      "url": "http://localhost:8888/index.php?module=Leads&action=index"
    },
    
    {
      "action": "wait",
      "timeout": 10000
    }


  ]
}