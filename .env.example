# Export these variables in the shell that starts the app.
# PowerShell: $env:PORT = '4173'; npm run ui
HOST=127.0.0.1
PORT=4173
# Optional independent storage location; default is the repository.
# STUDIO_WORKSPACE=D:/Maya/workspace
MAX_ACTIVE_RUNS=2
RUN_TIMEOUT_MS=120000
DB_DISABLED=1
# Enable for HTTPS installations. Keep HOST local when using a reverse proxy.
COOKIE_SECURE=0
# DATABASE_URL=postgres://teststudio:change-me@localhost:5433/teststudio
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# AI_PRICE_INPUT=3
# AI_PRICE_OUTPUT=15
# AI_DAILY_TOKEN_CAP=200000
# Optional chat-agent authentication. Reference the variable name in Agent Testing.
# MAYA_AGENT_SUPPORT_HEADERS={"Authorization":"Bearer replace-with-your-agent-token"}
# RECORDER_HEADLESS=1
