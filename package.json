{
  "name": "playwright-json-framework",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "ui": "tsx ui/server.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:studio": "playwright test --config playwright.studio.config.ts",
    "check": "npm run typecheck && node --check ui/public/app.js && node --check ui/public/agent-testing.js && node --check ui/public/run-inspector.js && npm run test:unit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
